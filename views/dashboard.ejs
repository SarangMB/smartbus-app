<%- include("partials/header", { user, notice }) %>
<div class="page-heading"><div><div class="eyebrow">YOUR SMARTBUS WORKSPACE</div><h1><%= role === "student" ? "Student dashboard" : role === "driver" ? "Driver dashboard" : "Admin dashboard" %></h1><p class="muted"><%= role === "student" ? "Renew your pass, view your QR pass and follow your assigned bus." : role === "driver" ? "Share your bus location and verify student passes." : "Manage routes, fares, driver access, payments and issued passes." %></p></div><div class="date-chip">● &nbsp; SECURE TRANSPORT PORTAL</div></div>
<% if (role === "student") { %>
<div class="stats"><div class="stat"><span>ASSIGNED BUS</span><strong><%= passes.length ? passes[0].bus : "—" %></strong><small>Based on your selected boarding point</small></div><div class="stat"><span>MY PASSES</span><strong><%= passes.length %></strong><small>Digital pass records</small></div><div class="stat"><span>PAYMENT RECORDS</span><strong><%= payments.length %></strong><small>Saved in MongoDB</small></div></div>
<div class="two-col"><section class="panel"><div class="panel-head"><div><h2>Renew your bus pass</h2><p>Choose your boarding point to see the fare and assigned bus.</p></div><span class="iconbox">↻</span></div>
<form method="post" action="/renew" id="renew-form"><input type="hidden" name="request_key" value="<%= renewRequestKey %>"><label>Boarding point</label><select name="stop_id" id="stop-select" required><option value="">Select boarding point</option><% stops.forEach(stop => { %><option value="<%= stop._id %>" data-fare="<%= Number(stop.fare).toFixed(2) %>" data-bus="<%= stop.bus %>"><%= stop.name %> · <%= stop.bus %></option><% }) %></select><div class="fare-row"><div><small>AMOUNT TO PAY</small><strong id="fare-display">₹0.00</strong></div><span id="bus-display">Bus assigned after selection</span></div><label>Payment simulation</label><select name="payment_result"><option value="success">Simulate successful payment</option><option value="failed">Simulate failed payment</option></select><button class="primary full" id="renew-submit">Pay & generate QR pass <span>→</span></button><p class="fineprint">Prototype payment only. No real money is charged. Successful payment and failed attempts are saved in MongoDB.</p></form></section>
<section class="panel location-panel"><div class="panel-head"><div><h2>Track your bus</h2><p>Latest location from the driver assigned to your active pass.</p></div><span class="live-dot">LIVE</span></div><div id="student-location-map" class="real-map" aria-label="Map showing the latest bus location"></div><div class="location-readout"><strong id="location-status">Waiting for driver location…</strong><span id="location-coordinates">Coordinates will appear here</span><span id="location-updated"></span></div><button class="secondary full" id="refresh-location">Get latest bus location</button><p class="fineprint">This shows the latest location shared by your assigned driver. It is not continuous tracking; ask the driver to share their current location again for a newer position.</p></section></div>
<section class="panel"><div class="panel-head"><div><h2>My digital passes</h2><p>Show the QR code to your driver. The pass details are saved in MongoDB.</p></div><span class="iconbox">▦</span></div>
<% if (passes.length) { %><div class="pass-list"><% passes.forEach(p => { const expiry = new Date(p.expiresAt); const active = expiry >= new Date() && p.status === "active" && p.paymentStatus === "paid"; %><article class="digital-pass"><div class="pass-top"><span class="pass-brand">SMARTBUS <small>VERIFIABLE DIGITAL PASS</small></span><span class="status-pill <%= active ? "active" : "" %>"><%= active ? "ACTIVE" : "EXPIRED / INACTIVE" %></span></div><div class="pass-main"><div><small>PASS HOLDER</small><h3><%= p.studentName || user.name %></h3><small>BOARDING POINT</small><strong><%= p.stopName %></strong><div class="pass-meta"><span>ASSIGNED BUS <b><%= p.bus %></b></span><span>VALID UNTIL <b><%= expiry.toISOString().slice(0,10) %></b></span></div><div class="pass-meta"><span>TRANSACTION <b><%= p.transactionId %></b></span><span>PAID <b>₹<%= Number(p.amount).toFixed(2) %></b></span></div><div class="pass-meta"><span>PASS ID <b><%= p._id.toString() %></b></span></div></div><div class="qr-block"><img class="qr" src="/pass/<%= p._id %>/qr.png" alt="Generated SmartBus QR code"><small>SCAN / VERIFY</small></div></div></article><% }) %></div><% } else { %><div class="empty"><div class="empty-icon">▤</div><strong>Your digital pass will appear here</strong><p>Select a boarding point and complete the demo payment to generate your pass and QR code.</p></div><% } %></section>
<section class="panel"><div class="panel-head"><div><h2>Payment history</h2><p>Each successful or failed payment attempt is stored in the database.</p></div></div><% if (payments.length) { %><div class="table-wrap"><table><thead><tr><th>Transaction</th><th>Boarding point</th><th>Bus</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead><tbody><% payments.forEach(p => { %><tr><td><%= p.transactionId %></td><td><%= p.stopName %></td><td><%= p.bus %></td><td>₹<%= Number(p.amount).toFixed(2) %></td><td><span class="status-pill <%= p.status === "paid" ? "active" : "" %>"><%= p.status.toUpperCase() %></span></td><td><%= new Date(p.createdAt || p.paidAt).toISOString().slice(0,10) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">No payment attempts yet.</div><% } %></section>
<% } else if (role === "driver") { %>
<div class="stats"><div class="stat"><span>ASSIGNED BUS</span><strong><%= user.bus || "Not assigned" %></strong><small>Set by administrator</small></div><div class="stat"><span>PASS CHECK</span><strong>QR / ID</strong><small>Validate bus and expiry</small></div><div class="stat"><span>LOCATION</span><strong>GPS</strong><small>Share while on duty</small></div></div>
<div class="two-col"><section class="panel"><div class="panel-head"><div><h2>Live location sharing</h2><p>Share your current location with students assigned to your bus.</p></div><span class="live-dot">LIVE</span></div><div id="driver-location-map" class="real-map" aria-label="Map showing your current location"></div><div class="location-readout"><strong id="driver-location-status">Current location has not been shared</strong><span id="driver-location-coordinates">Your coordinates will appear here</span></div><button class="primary full" id="start-location">Get and share my current location</button><p class="fineprint">Click the button and allow browser location permission. Your current coordinates will be saved to MongoDB for students with an active pass assigned to <%= user.bus || "your bus" %>. This version shares one location at a time, not continuous tracking.</p></section>
<section class="panel"><div class="panel-head"><div><h2>Verify student pass</h2><p>Enter the pass ID or transaction ID printed under the QR code.</p></div><span class="iconbox">✓</span></div><form id="verify-form"><label>Pass ID / Transaction ID</label><input id="verify-code" placeholder="Paste pass ID or SB transaction ID" required><button class="primary full">Verify pass <span>→</span></button></form><div id="verify-result" class="verify-result hidden"></div><div class="info-note">Checks payment status, expiry and assigned bus. A QR scanner camera is not included; use the pass ID or transaction ID for verification.</div></section></div>
<% } else { %>
<div class="stats"><div class="stat"><span>BOARDING POINTS</span><strong><%= stops.length %></strong><small>Active stops and fare rules</small></div><div class="stat"><span>DRIVER ACCOUNTS</span><strong><%= drivers.length %></strong><small>Created by admin only</small></div><div class="stat"><span>PAYMENT RECORDS</span><strong><%= payments.length %></strong><small>Successful and failed attempts</small></div></div>
<section class="panel"><div class="panel-head"><div><h2>Boarding points, fares & bus allocation</h2><p>Each boarding point has one standardized bus assignment (BUS-01 to BUS-10). A successful payment copies that stop’s bus and fare to the student pass.</p></div></div><div class="fare-admin"><% stops.forEach(stop => { %><form method="post" action="/stops/update" class="fare-edit admin-stop-edit"><div><strong><%= stop.name %></strong><small>Stop ID · <%= stop._id.toString().slice(-7) %></small></div><input type="hidden" name="stop_id" value="<%= stop._id %>"><input type="hidden" name="version" value="<%= stop.version %>"><label>Boarding point<input name="name" value="<%= stop.name %>" required></label><label>Fare (₹)<input name="fare" type="number" min="0" step="0.01" value="<%= Number(stop.fare).toFixed(2) %>" required></label><label>Assigned bus<select name="bus" required><% busNumbers.forEach(busNo => { %><option value="<%= busNo %>" <%= stop.bus === busNo ? "selected" : "" %>><%= busNo %></option><% }) %></select></label><button class="secondary">Save changes</button></form><% }) %></div><h3 class="subheading">Add a boarding point</h3><form method="post" action="/stops/add" class="form-grid"><div><label>Boarding point name</label><input name="name" placeholder="e.g. North Junction" required></div><div><label>Fare (₹)</label><input name="fare" type="number" min="0" step="0.01" placeholder="650" required></div><div><label>Assigned bus</label><select name="bus" required><% busNumbers.forEach(busNo => { %><option value="<%= busNo %>"><%= busNo %></option><% }) %></select></div><button class="primary">Add boarding point</button></form></section>
<section class="panel"><div class="panel-head"><div><h2>Driver registry & verification</h2><p>Driver profiles are stored separately in MongoDB <code>drivers</code>. Create a driver, then verify their record here before their login is enabled. Bus numbers use the standard BUS-01 to BUS-10 format.</p></div></div><form method="post" action="/drivers/add" class="form-grid driver-create"><div><label>Driver full name</label><input name="name" required placeholder="Full name"></div><div><label>Username</label><input name="username" required minlength="3" pattern="[A-Za-z0-9._-]+" placeholder="driver.name"></div><div><label>Email (optional)</label><input name="email" type="email" placeholder="driver@college.edu"></div><div><label>Temporary password</label><input name="password" type="password" minlength="8" required placeholder="At least 8 characters"></div><div><label>Assigned bus</label><select name="bus" required><% busNumbers.forEach(busNo => { %><option value="<%= busNo %>"><%= busNo %></option><% }) %></select></div><button class="primary">Create driver login</button></form><% if (drivers.length) { %><div class="table-wrap top-gap"><table><thead><tr><th>Driver</th><th>Username</th><th>Email</th><th>Assigned bus</th><th>Verification</th><th>Created</th><th>Admin action</th></tr></thead><tbody><% drivers.forEach(d => { %><tr><td><strong><%= d.name %></strong><br><small><%= String(d._id).slice(-8) %></small></td><td><%= d.username %></td><td><%= d.email || "—" %></td><td><%= d.bus || "—" %></td><td><span class="status-pill <%= d.verificationStatus === "verified" ? "active" : "" %>"><%= (d.verificationStatus || "pending").toUpperCase() %></span><% if (d.verifiedAt) { %><br><small><%= new Date(d.verifiedAt).toISOString().slice(0,10) %></small><% } %></td><td><%= new Date(d.createdAt).toISOString().slice(0,10) %></td><td><% if (d.verificationStatus !== "verified") { %><form method="post" action="/drivers/<%= d._id %>/verify" class="inline-action"><button class="primary small-button">Verify driver</button></form><% } else { %><form method="post" action="/drivers/<%= d._id %>/revoke" class="inline-action" onsubmit="return confirm('Disable this driver login?')"><button class="secondary small-button">Revoke</button></form><% } %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">No driver records yet. Create a driver above; each driver will appear here and in the MongoDB <code>drivers</code> collection.</div><% } %></section>
<section class="panel"><div class="panel-head"><div><h2>All issued passes</h2><p>Pass, student, boarding point, standardized bus number and amount records stored in MongoDB.</p></div></div><% if (passes.length) { %><div class="table-wrap"><table><thead><tr><th>Student</th><th>Username</th><th>Boarding point</th><th>Bus</th><th>Amount</th><th>Transaction</th><th>Expires</th></tr></thead><tbody><% passes.forEach(p => { %><tr><td><%= p.studentName %></td><td><%= p.username %></td><td><%= p.stopName %></td><td><%= p.bus %></td><td>₹<%= Number(p.amount).toFixed(2) %></td><td><%= p.transactionId %></td><td><%= new Date(p.expiresAt).toISOString().slice(0,10) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">No passes have been issued yet.</div><% } %></section>
<section class="panel"><div class="panel-head"><div><h2>Payment ledger</h2><p>Payment attempts are stored separately from pass records.</p></div></div><% if (payments.length) { %><div class="table-wrap"><table><thead><tr><th>Transaction</th><th>Student</th><th>Boarding point</th><th>Bus</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead><tbody><% payments.forEach(p => { %><tr><td><%= p.transactionId %></td><td><%= p.studentName %> (<%= p.username %>)</td><td><%= p.stopName %></td><td><%= p.bus %></td><td>₹<%= Number(p.amount).toFixed(2) %></td><td><span class="status-pill <%= p.status === "paid" ? "active" : "" %>"><%= p.status.toUpperCase() %></span></td><td><%= new Date(p.createdAt || p.paidAt).toISOString().slice(0,10) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">No payment records yet.</div><% } %></section>
<% } %>
<%- include("partials/footer") %>
